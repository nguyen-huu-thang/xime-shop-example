# ─── Cơ sở dữ liệu ────────────────────────────────────────────────────────────
# PostgreSQL async URL — thay user/password/host/dbname cho phù hợp
DATABASE_URL=postgresql+asyncpg://shop_user:shop_pass@localhost:5432/shop_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Chuỗi bí mật — tạo bằng: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret-of-at-least-32-chars
JWT_ALGORITHM=HS256
# Thời gian sống access token (phút)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Thời gian sống refresh token (phút) — mặc định 7 ngày
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ─── File Upload ──────────────────────────────────────────────────────────────
# Thư mục lưu file upload (tương đối hoặc tuyệt đối)
UPLOAD_DIR=public/data
